--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8422398df109fc249ad0f9ec07df7968, type: 3}
  m_Name: VoiceText
  m_EditorClassIdentifier: Assembly-CSharp::VoiceText
  voiceTextData:
  - name: Maple
    dialogue: "\u771F\u3063\u8D64\u306A\u7D05\u8449\u304B\u2026\u2026\u304D\u308C\u3044\u3060\u306D\u3002"
  - name: DeadLeaves
    dialogue: "\u67AF\u308C\u8449\u304B\u3089\u30AB\u30B5\u30C3\u3066\u97F3\u304C\u3059\u308B\u305F\u3073\u306B\u3001\u541B\u3092\u904B\u3093\u3067\u308B\u5B9F\u611F\u304C\u308F\u304F\u3088"
  - name: FallenLeaves
    dialogue: "\u541B\u304C\u6559\u3048\u3066\u304F\u308C\u306A\u304D\u3083\u8449\u3063\u3071\u3067\u6ED1\u308B\u3068\u3053\u308D\u3060\u3063\u305F\u3002\u52A9\u304B\u308B\u3088"
  - name: Plum
    dialogue: "\u767E\u8349\u5712\u306E\u6885\u306F\u6709\u540D\u3060\u3082\u3093\u306D\u3002\u307B\u3089\u3001\u826F\u3044\u9999\u308A\u2026\u2026\u3002"
  - name: Squirrel
    dialogue: "\u3048\u3063\u3001\u30EA\u30B9\u304C\u3044\u308B\u306E\uFF1F\u9A5A\u304B\u305B\u3066\u9003\u3052\u3061\u3083\u308F\u306A\u3044\u3088\u3046\u306B\u3001\u9759\u304B\u306B\u9032\u3080\u306D"
  - name: Bird
    dialogue: "\u9CE5\u3055\u3093\u2026\u2026\u3042\u3063\u3001\u9003\u3052\u3061\u3083\u3063\u305F\uFF01\u79C1\u305F\u3061\u304C\u4EF2\u826F\u304F\u3057\u3066\u308B\u304B\u3089\u3001\u7167\u308C\u3061\u3083\u3063\u305F\u306E\u304B\u306A\uFF1F"
  - name: Branch
    dialogue: "\u304A\u3063\u3068\u3001\u6728\u306E\u6839\u3063\u3053\u304C\u5F35\u308A\u51FA\u3057\u3066\u308B\u306E\u304B\u3002\u5371\u3046\u304F\u5F15\u3063\u304B\u304B\u308B\u3068\u3053\u308D\u3060\u3063\u305F\u3002"
  - name: Rock
    dialogue: "\u8DB3\u5143\u306B\u77F3\u304C\u3042\u308B\u3093\u3060\u306D\u3002\u3057\u3063\u304B\u308A\u8E0F\u307F\u3057\u3081\u3066\u767B\u308B\u304B\u3089\u2026\u2026\u5B89\u5FC3\u3057\u3066"
  - name: Half
    dialogue: "\u3075\u3045\u2026\u2026\u3042\u3068\u534A\u5206\u3060\u306D\uFF01\u541B\u306E\u30AC\u30A4\u30C9\u3001\u3059\u3063\u3054\u304F\u52A9\u304B\u3063\u3066\u308B\u3088\u3002\u9811\u5F35\u308B\u306D\uFF01"
  - name: 3Step
    dialogue: "\u3042\u3068\u4E09\u6B69\u2026\u2026\uFF01\u6700\u5F8C\u307E\u3067\u3057\u3063\u304B\u308A\u898B\u5B88\u3063\u3066\u3066\u306D"
  - name: 2Step
    dialogue: "\u3042\u3068\u4E8C\u6B69\u3002\u3075\u3075\u3001\u3082\u3046\u3059\u3050\u3067\u9802\u4E0A\u3060\u3088\u2026\u2026\uFF01"
  - name: LastStep
    dialogue: "\u6700\u5F8C\u306E\u4E00\u6BB5\uFF01\u3044\u304F\u3088\uFF5E\uFF01"
  - name: Goal
    dialogue: "\u3054\u30FC\u30FC\u308B\uFF01\uFF01\uFF01"
  - name: Start
    dialogue: "\u4E8C\u4EBA\u306E\u606F\u3001\u5408\u308F\u305B\u3088\u3046\u306D\u3002\u3044\u304F\u3088\uFF01"
  - name: Day
    dialogue: "\u2026\u2026\u3042\u306F\u306F\u3001\u304A\u75B2\u308C\u69D8\uFF01\u898B\u3066\u3001\u304A\u65E5\u69D8\u304C\u3042\u3093\u306A\u306B\u9AD8\u3044\u3088\u3002\u541B\u304C\u3059\u3070\u3084\u304F\u6B63\u78BA\u306B\u6559\u3048\u3066\u304F\u308C\u305F\u304B\u3089\u3001\u304A\u663C\u4F11\u307F\u306B\u9593\u306B\u5408\u3063\u3061\u3083\u3063\u305F\u306D\u3002\u3055\u3042\u3001\u4E00\u7DD2\u306B\u304A\u3044\u3057\u3044\u304A\u5F01\u5F53\u98DF\u3079\u3088\u3046\uFF01"
  - name: Evening
    dialogue: "\u2026\u2026\u3042\u306F\u306F\u3001\u304A\u75B2\u308C\u69D8\uFF01\u308F\u3042\u3001\u898B\u3066\u2026\u2026\u7A7A\u304C\u771F\u3063\u8D64\u3060\u3088\u3002\u968E\u6BB5\u3092\u4E0A\u3063\u3066\u308B\u9593\u306F\u8DB3\u5143\u306B\u5FC5\u6B7B\u3060\u3063\u305F\u3051\u3069\u3001\u3053\u3093\u306A\u306B\u7DBA\u9E97\u306A\u5915\u713C\u3051\u304C\u898B\u308C\u308B\u306A\u3093\u3066\u3002\u9811\u5F35\u3063\u3066\u767B\u3063\u3066\u3001\u672C\u5F53\u306B\u826F\u304B\u3063\u305F\u306D\uFF01"
  - name: Night
    dialogue: "\u2026\u2026\u3042\u306F\u306F\u3001\u304A\u75B2\u308C\u69D8\uFF01\u3042\u3093\u306A\u306B\u660E\u308B\u304B\u3063\u305F\u306E\u306B\u3082\u3046\u771F\u3063\u6697\u2026\u2026\u672C\u5F53\u306B\u4E00\u65E5\u4E2D\u767B\u308A\u304D\u3063\u3061\u3083\u3063\u305F\u3093\u3060\u306D\u3002\u541B\u306E\u30CA\u30D3\u304C\u3042\u3063\u305F\u304B\u3089\u3001\u6700\u5F8C\u307E\u3067\u8AE6\u3081\u305A\u306B\u9811\u5F35\u308C\u305F\u3088\u3002\u6700\u9AD8\u306E\u591C\u666F\u3060\u306D\uFF01"
  - name: LaterDate
    dialogue: "\u2026\u2026\u3042\u306F\u306F\u3001\u304A\u75B2\u308C\u69D8\uFF01\u2026\u2026\u3063\u3066\u3001\u6C17\u3065\u3044\u305F\u3089\u65E5\u3092\u307E\u305F\u3044\u3058\u3083\u3063\u305F\uFF01\uFF1F\u4E00\u65E5\u4E2D\u304A\u59EB\u69D8\u62B1\u3063\u3053\u3067\u968E\u6BB5\u306A\u3093\u3066\u3001\u79C1\u305F\u3061\u4F1D\u8AAC\u4F5C\u3063\u3061\u3083\u3063\u305F\u304B\u3082\u3002\u3067\u3082\u3001\u305A\u3063\u3068\u541B\u3068\u304F\u3063\u3064\u3044\u3066\u3044\u305F\u304B\u3089\u304B\u306A\u2026\u2026\u4E0D\u601D\u8B70\u3068\u75B2\u308C\u3088\u308A\u3001\u5E78\u305B\u306A\u6C17\u6301\u3061\u306E\u307B\u3046\u304C\u52DD\u3063\u3061\u3083\u3063\u3066\u308B\u3088\u3002\u306D\u3048\u3001\u3082\u3046\u5C11\u3057\u3060\u3051\u3053\u306E\u307E\u307E\u3067\u3082\u3044\u3044\uFF1F"
